{
  "name": "@sanity/google-maps-input",
  "version": "4.2.1",
  "description": "Sanity plugin providing input handlers for geo-related input types using Google Maps",
  "keywords": [
    "sanity",
    "cms",
    "headless",
    "realtime",
    "content",
    "google-maps-input",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/sanity-io/google-maps-input#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/google-maps-input/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sanity-io/google-maps-input.git"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browserslist": "extends @sanity/browserslist-config",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "build:studio": "sanity build studio -y",
    "dev": "sanity dev",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "watch": "pkg-utils watch --strict",
    "prepare": "true"
  },
  "dependencies": {
    "@sanity/icons": "^3.7.4",
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/ui": "^3.1.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@sanity/pkg-utils": "^10.4.14",
    "@sanity/plugin-kit": "^4.0.20",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "sanity": "^5.20.0",
    "semantic-release": "^25.0.3",
    "styled-components": "^6.4.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "sanity": "^3.19.0 || ^4.0.0-0 || ^5.0.0",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=18"
  },
  "alias": {
    "google": {
      "global": "google"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0"
  }
}
