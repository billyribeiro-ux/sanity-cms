{
  "name": "@sanity/dashboard",
  "version": "5.0.1",
  "description": "Tool for rendering dashboard widgets",
  "keywords": [
    "sanity",
    "cms",
    "headless",
    "realtime",
    "content",
    "dashboard",
    "sanity-plugin",
    "sanity-tool"
  ],
  "homepage": "https://github.com/sanity-io/dashboard#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/dashboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sanity-io/dashboard.git"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.esm.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "prebuild": "pnpm run clean && plugin-kit verify-package --silent && pkg-utils",
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "clean": "rimraf lib",
    "compile": "tsc --noEmit",
    "dev": "sanity dev",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "prepare": "true",
    "prepublishOnly": "pnpm run build",
    "watch": "pkg-utils watch --strict"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "dependencies": {
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/ui": "^3.1.14",
    "lodash": "^4.18.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@sanity/pkg-utils": "^10.4.14",
    "@sanity/plugin-kit": "^4.0.20",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.2",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5",
    "rimraf": "^6.1.3",
    "sanity": "^5.20.0",
    "semantic-release": "^25.0.3",
    "styled-components": "^6.4.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18 || >=19.0.0-0",
    "sanity": "^3 || ^4.0.0-0 || ^5.0.0",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0",
    "cross-spawn": "^7.0.6"
  },
  "sanityExchangeUrl": "https://www.sanity.io/exchange/dashboard"
}
