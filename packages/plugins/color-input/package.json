{
  "name": "@sanity/color-input",
  "version": "4.0.6",
  "description": "Color input",
  "keywords": [
    "sanity",
    "cms",
    "headless",
    "realtime",
    "content",
    "color-input",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/sanity-io/color-input#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/color-input/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sanity-io/color-input.git"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.esm.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "pkg-utils build --strict --check --clean",
    "compile": "tsc --noEmit",
    "format": "prettier --write --cache --ignore-unknown .",
    "lint": "eslint .",
    "prepare": "true",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "prettier": "@sanity/prettier-config",
  "dependencies": {
    "@sanity/icons": "^3.7.4",
    "@sanity/ui": "^3.1.14",
    "react-color": "^2.19.3",
    "tinycolor2": "^1.6.0",
    "use-effect-event": "^2.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@sanity/pkg-utils": "^10.4.14",
    "@sanity/prettier-config": "3.0.0",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@types/react": "^19.2.14",
    "@types/react-color": "^3.0.13",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.2",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanity": "^5.20.0",
    "semantic-release": "^25.0.3",
    "styled-components": "^6.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19",
    "sanity": "^3.23.0 || ^4.0.0-0",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "sanityExchangeUrl": "https://www.sanity.io/plugins/color-input"
}
