{
  "name": "@sanity/document-internationalization",
  "version": "4.1.1",
  "description": "Create unique translations of a document based on its language, joined by a shared reference document.",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/sanity-io/document-internationalization#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/document-internationalization/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sanity-io/document-internationalization.git"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "run-s clean && pkg-utils build --strict && pkg-utils --strict",
    "clean": "rimraf dist",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "prepare": "true",
    "prepublishOnly": "run-s build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^3.7.4",
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/mutator": "^5.20.0",
    "@sanity/ui": "^3.1.14",
    "@sanity/uuid": "^3.0.2",
    "sanity-plugin-internationalized-array": "^5.1.0",
    "sanity-plugin-utils": "^1.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@sanity/pkg-utils": "10.4.14",
    "@sanity/plugin-kit": "^4.0.20",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.2",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5",
    "rimraf": "^6.1.3",
    "sanity": "^5.20.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "sanity": "^3.40.0 || ^4.0.0-0 || ^5",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=14"
  },
  "publishConfig": {
    "access": "public"
  }
}
