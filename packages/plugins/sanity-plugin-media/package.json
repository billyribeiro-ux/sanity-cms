{
  "name": "sanity-plugin-media",
  "version": "4.1.1",
  "description": "This version of `sanity-plugin-media` is for Sanity Studio V3.",
  "keywords": [
    "sanity",
    "cms",
    "headless",
    "realtime",
    "content",
    "sanity-plugin",
    "asset",
    "browser"
  ],
  "homepage": "https://github.com/sanity-io/sanity-plugin-media#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/sanity-plugin-media/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sanity-io/sanity-plugin-media.git"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "type": "commonjs",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "clean": "rimraf dist",
    "dev": "sanity dev",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "prepare": "true",
    "prepublishOnly": "pnpm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@sanity/client": "^7.21.0",
    "@sanity/color": "^3.0.6",
    "@sanity/icons": "^3.7.4",
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/ui": "^3.1.14",
    "@sanity/uuid": "^3.0.2",
    "@tanem/react-nprogress": "^6.0.3",
    "copy-to-clipboard": "^3.3.3",
    "date-fns": "^4.1.0",
    "filesize": "^11.0.15",
    "groq": "^5.20.0",
    "is-hotkey-esm": "^1.0.0",
    "nanoid": "^5.1.7",
    "pluralize": "^8.0.0",
    "react-dropzone": "^15.0.0",
    "react-file-icon": "^1.6.0",
    "react-hook-form": "^7.72.1",
    "react-redux": "^9.2.0",
    "react-select": "^5.10.2",
    "react-virtuoso": "^4.18.5",
    "redux": "^5.0.1",
    "redux-observable": "3.0.0-rc.3",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@sanity/pkg-utils": "^10.4.14",
    "@sanity/plugin-kit": "^4.0.20",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@sanity/vision": "^5.20.0",
    "@types/is-hotkey": "^0.1.10",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-file-icon": "^1.0.5",
    "@codemirror/lint": "^6.9.5",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5",
    "rimraf": "^6.1.3",
    "sanity": "^5.20.0",
    "standard-version": "^9.5.0",
    "styled-components": "^6.4.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19",
    "react-is": "^18.3 || ^19",
    "sanity": "^3.78 || ^4.0.0-0 || ^5",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=18"
  }
}
