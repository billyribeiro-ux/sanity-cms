{
  "name": "@sanity/orderable-document-list",
  "version": "1.5.1",
  "description": "Drag-and-drop Document Ordering without leaving the Editing surface",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/sanity-io/orderable-document-list#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/orderable-document-list/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sanity-io/orderable-document-list.git"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "dev": "sanity dev",
    "clean": "rimraf lib",
    "compile": "tsc --noEmit",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "true",
    "prepublishOnly": "pnpm run build",
    "watch": "pkg-utils watch --strict",
    "test": "vitest"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run lint:fix"
    }
  },
  "browserslist": "extends @sanity/browserslist-config",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@sanity/icons": "^3.7.4",
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/ui": "^3.1.14",
    "lexorank": "^1.0.5",
    "sanity-plugin-utils": "^1.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@sanity/pkg-utils": "^10.4.14",
    "@sanity/plugin-kit": "^4.0.20",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@sanity/vision": "^5.20.0",
    "@types/react": "^19.2.14",
    "@codemirror/lint": "^6.9.5",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "babel-eslint": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5",
    "rimraf": "^6.1.3",
    "sanity": "^5.20.0",
    "semantic-release": "^25.0.3",
    "styled-components": "^6.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "sanity": "^3.77.0 || ^4.0.0-0 || ^5.0.0",
    "styled-components": "^6.1"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sanityExchangeUrl": "https://www.sanity.io/plugins/orderable-document-list"
}
