{
  "name": "sanity-plugin-asset-source-unsplash",
  "version": "4.0.1",
  "description": "Use images from Unsplash.com in your Sanity Studio",
  "keywords": [
    "sanity",
    "plugin",
    "images",
    "unsplash",
    "assets",
    "source"
  ],
  "homepage": "https://github.com/sanity-io/sanity-plugin-asset-source-unsplash#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/sanity-plugin-asset-source-unsplash/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sanity-io/sanity-plugin-asset-source-unsplash.git"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "prepare": "true",
    "prepublishOnly": "npm run build",
    "test": "npm run lint && npm run type-check && npm run build",
    "type-check": "tsc --noEmit",
    "watch": "pkg-utils watch --strict"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "dependencies": {
    "@sanity/icons": "^3.7.4",
    "@sanity/ui": "^3.1.14",
    "react-infinite-scroll-component": "7.1.0",
    "react-photo-album": "3.6.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@sanity/pkg-utils": "^10.4.14",
    "@sanity/plugin-kit": "4.0.20",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanity": "^5.20.0",
    "semantic-release": "^25.0.3",
    "styled-components": "^6.4.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19",
    "sanity": "^4",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "sanityExchangeUrl": "https://www.sanity.io/plugins/sanity-plugin-asset-source-unsplash",
  "sanityPlugin": {
    "verifyPackage": {
      "nodeEngine": false,
      "sanityV2Json": false
    }
  }
}
