{
  "name": "cms-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Sanity Studio kit: schemas, plugins, and starter templates for client projects.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter starter dev",
    "starter": "pnpm --filter starter dev",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r --parallel exec rm -rf node_modules lib dist && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "codemirror": "^6.9.5"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
